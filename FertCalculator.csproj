<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>FertCalculator</RootNamespace>
    <AssemblyName>FertCalculator</AssemblyName>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <ApplicationIcon>FertCalculator.ico</ApplicationIcon>
    <!-- SDK-style auto-generates an app.config-based exe config -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- Required so the XAML markup compiler can resolve the netstandard
         FertCalculator.Core reference in its temporary project -->
    <IncludePackageReferencesDuringMarkupCompilation>true</IncludePackageReferencesDuringMarkupCompilation>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <!-- The nested MAUI/core/test projects live under this directory; keep their
       files out of this project's default SDK globs. -->
  <ItemGroup>
    <Compile Remove="FertCalculatorMaui\**" />
    <Compile Remove="FertCalculator.Core\**" />
    <Compile Remove="FertCalculator.Core.Tests\**" />
    <Compile Remove="FertCalculator.Web\**" />
    <Page Remove="FertCalculatorMaui\**" />
    <EmbeddedResource Remove="FertCalculatorMaui\**" />
    <EmbeddedResource Remove="FertCalculator.Core\**" />
    <None Remove="FertCalculatorMaui\**" />
    <None Remove="FertCalculator.Core\**" />
    <None Remove="FertCalculator.Core.Tests\**" />
    <None Remove="FertCalculator.Web\**" />
    <Content Remove="FertCalculator.Web\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="FertCalculator.Core\FertCalculator.Core.csproj" />
  </ItemGroup>

  <!-- Seed the data files next to the exe on every build. PreserveNewest so a
       modified Fertilizers.xml in the output folder isn't overwritten. -->
  <ItemGroup>
    <None Include="Fertilizers.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Mixes.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="FertCalculator.png" />
    <Resource Include="FertCalculator.ico" />
  </ItemGroup>

</Project>
