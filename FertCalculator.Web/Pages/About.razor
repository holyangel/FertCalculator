@page "/about"
@inject AppState State
@inject IJSRuntime JS

<PageTitle>About — Fertilizer Calculator</PageTitle>

<div class="container-fluid mt-3" style="max-width: 760px">
    <h3>About Fertilizer Calculator</h3>
    <p class="text-muted">
        A nutrient calculator for fertilizer mixes — pick products, enter quantities,
        and see the resulting elemental PPM breakdown of your solution.
    </p>

    <h5 class="mt-4">How it works</h5>
    <ul>
        <li>
            <strong>Quantities</strong> are interpreted per the current unit mode —
            grams or milliliters <em>per liter</em> or <em>per gallon</em> (toggle at the top).
            Switching modes changes the math, not your saved numbers.
        </li>
        <li>
            <strong>Solid products</strong> are dosed in grams;
            <strong>liquids</strong> (marked <code>mL</code>) are dosed in milliliters
            and converted to mass using each product's density.
        </li>
        <li>
            <strong>PPM</strong> = mg of nutrient per liter of solution. The breakdown
            shows elemental values — label-declared P₂O₅ and K₂O are converted to
            elemental P and K (×0.4364 and ×0.8301).
        </li>
        <li>
            The fertilizer library ships with ~100 common products. Entries not in the
            library can be added in the desktop app and imported here via XML.
        </li>
    </ul>

    <h5 class="mt-4">The tabs</h5>
    <ul>
        <li>
            <strong>Calculator</strong> — build a mix from the library and see its
            elemental PPM breakdown.
        </li>
        <li>
            <strong>Reservoir</strong> — enter a reservoir size (liters or gallons) and
            tick saved mixes to get exact amounts of each fertilizer to add —
            grams for solids, mL (plus gram-equivalent) for liquids.
        </li>
        <li>
            <strong>Compare</strong> — select two or more saved mixes for a
            side-by-side nutrient table (highest values highlighted) and bar
            charts for the macros.
        </li>
        <li>
            <strong>Target</strong> — scale a saved mix up or down to hit a PPM
            target for a chosen nutrient, or find how much of a single
            fertilizer to dose for a target contribution.
        </li>
        <li>
            <strong>Fertilizers</strong> — add your own products (P and K entered
            as label P₂O₅/K₂O values). Custom entries persist in this browser and
            are included in XML exports.
        </li>
    </ul>

    <h5 class="mt-4">What's saved where</h5>
    <ul>
        <li>
            <strong>Saved mixes</strong> and your <strong>unit preference</strong> live in your
            browser's <code>localStorage</code> — they persist across visits on this
            device and browser only. The built-in example mixes always load from
            the server; your own mixes merge in alongside them, and same-named
            local mixes override the built-ins.
        </li>
        <li>
            <strong>Custom fertilizers</strong> also persist in
            <code>localStorage</code> and merge into the bundled library.
        </li>
        <li>
            <strong>Nothing is sent anywhere.</strong> This is a fully static app — no
            account, no server-side storage, no tracking. Clearing site data or
            switching browsers/devices loses your saved mixes unless you export them.
        </li>
        <li>
            <strong>Export XML</strong> downloads your fertilizer library + mixes as a file.
            <strong>Import XML</strong> restores it. These files are cross-compatible with
            the Windows desktop app and the Android app — export on one, import on another.
        </li>
    </ul>

    <h5 class="mt-4">Reset local data</h5>
    <p class="text-muted">
        Clear this browser's saved data and go back to what the server ships.
        Neither touches your unit preference, and anything exported via XML is unaffected.
    </p>
    <div class="d-flex gap-2 flex-wrap">
        <button class="btn btn-sm btn-outline-warning" @onclick="ResetMixes">Reset mixes</button>
        <button class="btn btn-sm btn-outline-warning" @onclick="ResetFertilizers">Reset custom fertilizers</button>
    </div>
    @if (!string.IsNullOrEmpty(resetStatus))
    {
        <div class="alert alert-info py-1 px-2 mt-2">@resetStatus</div>
    }

    <h5 class="mt-4">Caveats</h5>
    <ul>
        <li>
            Product compositions come from labels and published specs — always
            cross-check against the label on your bottle, especially for products
            that reformulate.
        </li>
        <li>
            PPM figures are theoretical totals from guaranteed-analysis percentages.
            They don't account for source water, interactions, or availability.
        </li>
        <li>
            Liquid densities come from labels/SDS documents where available; a
            handful of products without published data still use estimates.
        </li>
    </ul>
</div>

@code {
    private string? resetStatus;

    protected override async Task OnInitializedAsync()
    {
        await State.EnsureLoaded();
    }

    private async Task ResetMixes()
    {
        bool ok = await JS.InvokeAsync<bool>("confirm",
            "Delete all locally saved mixes and restore the built-in ones? This cannot be undone (exports are unaffected).");
        if (!ok) return;
        await State.ResetMixes();
        resetStatus = "Mixes reset — you're back to the built-in set.";
    }

    private async Task ResetFertilizers()
    {
        bool ok = await JS.InvokeAsync<bool>("confirm",
            "Remove all custom fertilizers and restore the bundled library? This cannot be undone (exports are unaffected).");
        if (!ok) return;
        await State.ResetFertilizers();
        resetStatus = "Custom fertilizers removed — library is back to the bundled set.";
    }
}
