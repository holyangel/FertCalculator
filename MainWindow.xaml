<!-- MainWindow.xaml -->
<Window x:Class="FertilizerCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FertilizerCalculator"
        mc:Ignorable="d"
        Title="Fertilizer Calculator v2.0" Height="875" Width="1000" WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="SelectableValue" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Cursor" Value="IBeam"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with app title and unit toggle -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Fertilizer Calculator" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Units:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <Button x:Name="UnitToggleButton" Content="PPM per Liter" Width="120" Height="30" Click="UnitToggleButton_Click"/>
                <Button Content="Import" Width="80" Margin="10,0,0,0" Click="ImportButton_Click"/>
                <Button Content="Export" Width="80" Margin="5,0,0,0" Click="ExportButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Main content area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left panel: Fertilizer management -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,5">
                    <TextBlock Text="Available Fertilizers" FontSize="16" FontWeight="Bold"/>
                    <TextBox x:Name="FertilizerSearchBox" Margin="0,5,0,0" Height="24"
                             TextChanged="FertilizerSearchBox_TextChanged"
                             ToolTip="Type to filter fertilizers by name"/>
                </StackPanel>

                <ListBox x:Name="FertilizerListBox" Grid.Row="1" SelectionMode="Single" MouseDoubleClick="FertilizerListBox_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"/>
                                <TextBlock Text=" (mL)" Opacity="0.6"
                                           Visibility="{Binding IsLiquid, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,5">
                    <Button Content="Add New" Width="90" Click="AddFertilizerButton_Click"/>
                    <Button Content="Edit" Width="90" Click="EditFertilizerButton_Click"/>
                    <Button Content="Delete" Width="90" Click="DeleteFertilizerButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Right panel: Mix creation and nutrient display -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="250"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Current mix header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Current Mix" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="CurrentMixNameText" Text="— unsaved —" Opacity="0.7"
                                   Margin="10,0,0,0" VerticalAlignment="Bottom"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <ComboBox x:Name="SavedMixesComboBox" Width="200" DisplayMemberPath="Name" Margin="0,0,0,5"/>
                        <Button Content="Load" Width="70" Click="LoadMixButton_Click" Margin="0,0,0,5"/>
                        <Button Content="Delete" Width="70" Click="DeleteMixButton_Click" Margin="0,0,0,5"/>
                        <Button Content="Compare" Width="70" Click="CompareMixesButton_Click" Margin="5,0,0,5" ToolTip="Compare two saved mixes"/>
                    </StackPanel>
                </Grid>

                <!-- Current mix ingredients -->
                <DataGrid x:Name="MixListBox" 
                          Grid.Row="1" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False" 
                          CellEditEnding="MixListBox_CellEditEnding"
                          PreviewKeyDown="MixListBox_PreviewKeyDown"
                          MouseDoubleClick="MixListBox_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fertilizer" Binding="{Binding FertilizerName}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn x:Name="QuantityColumn" Header="Quantity (g/L)" Binding="{Binding Quantity, StringFormat=F2}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <EventSetter Event="PreviewTextInput" Handler="DecimalInputValidation"/>
                                    <EventSetter Event="PreviewKeyDown" Handler="TextBox_PreviewKeyDown"/>
                                    <EventSetter Event="Loaded" Handler="QuantityTextBox_Loaded"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Mix controls -->
                <Grid Grid.Row="2" Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add to Mix" Width="100" Click="AddToMixButton_Click"/>
                        <Button Content="Remove" Width="100" Click="RemoveFromMixButton_Click"/>
                        <Button Content="Clear Mix" Width="100" Click="ClearMixButton_Click"/>
                        <Button Content="Save Mix" Width="80" Click="SaveMixButton_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                    </StackPanel>
                </Grid>

                <!-- Nutrient breakdown -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="Nutrient Breakdown" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Content="Copy" Width="60" Height="22" Margin="10,0,0,0" Padding="0"
                                    VerticalAlignment="Center" Click="CopyBreakdown_Click"
                                    ToolTip="Copy the nutrient breakdown to the clipboard"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Nutrient labels -->
                            <TextBlock Grid.Row="0" Text="Nitrogen (N)" FontWeight="Bold"/>
                            <TextBlock Grid.Row="1" Text="Phosphorus (P)"/>
                            <TextBlock Grid.Row="2" Text="Potassium (K)"/>
                            <TextBlock Grid.Row="3" Text="Calcium (Ca)"/>
                            <TextBlock Grid.Row="4" Text="Magnesium (Mg)"/>
                            <TextBlock Grid.Row="5" Text="Sulfur (S)"/>
                            <TextBlock Grid.Row="6" Text="Boron (B)"/>
                            <TextBlock Grid.Row="7" Text="Copper (Cu)"/>
                            <TextBlock Grid.Row="8" Text="Iron (Fe)"/>
                            <TextBlock Grid.Row="9" Text="Manganese (Mn)"/>
                            <TextBlock Grid.Row="10" Text="Molybdenum (Mo)"/>
                            <TextBlock Grid.Row="11" Text="Zinc (Zn)"/>
                            <TextBlock Grid.Row="12" Text="Chlorine (Cl)"/>
                            <TextBlock Grid.Row="13" Text="Silica (Si)"/>
                            <TextBlock Grid.Row="14" Text="Humic Acid"/>
                            <TextBlock Grid.Row="15" Text="Fulvic Acid"/>
                            <TextBlock Grid.Row="16" Text="Kelp"/>
                            <TextBlock Grid.Row="17" Text="" Height="10"/>
                            <TextBlock Grid.Row="18" Text="TOTAL PPM" FontWeight="Bold"/>

                            <!-- Nutrient values -->
                            <TextBox x:Name="NitrogenValueTextBlock" Grid.Row="0" Grid.Column="1" Text="0.00" TextAlignment="Right" Style="{StaticResource SelectableValue}"/>
                            <TextBox x:Name="PhosphorusValueTextBlock" Grid.Row="1" Grid.Column="1" Text="0.00" TextAlignment="Right" Style="{StaticResource SelectableValue}"/>
                            <TextBox x:Name="PotassiumValueTextBlock" Grid.Row="2" Grid.Column="1" Text="0.00" TextAlignment="Right" Style="{StaticResource SelectableValue}"/>
                            <TextBox x:Name="CalciumValueTextBlock" Grid.Row="3" Grid.Column="1" Text="0.00" TextAlignment="Right" Style="{StaticResource SelectableValue}"/>
                            <TextBox x:Name="MagnesiumValueTextBlock" Grid.Row="4" Grid.Column="1" Text="0.00" TextAlignment="Right" Style="{StaticResource SelectableValue}"/>
                            <TextBox x:Name="SulfurValueTextBlock" Grid.Row="5" Grid.Column="1" Text="0.00" TextAlignment="Right" Style="{StaticResource SelectableValue}"/>
                            <TextBox x:Name="BoronValueTextBlock" Grid.Row="6" Grid.Column="1" Text="0.00" TextAlignment="Right" Style="{StaticResource SelectableValue}"/>
                            <TextBox x:Name="CopperValueTextBlock" Grid.Row="7" Grid.Column="1" Text="0.00" TextAlignment="Right" Style="{StaticResource SelectableValue}"/>
                            <TextBox x:Name="IronValueTextBlock" Grid.Row="8" Grid.Column="1" Text="0.00" TextAlignment="Right" Style="{StaticResource SelectableValue}"/>
                            <TextBox x:Name="ManganeseValueTextBlock" Grid.Row="9" Grid.Column="1" Text="0.00" TextAlignment="Right" Style="{StaticResource SelectableValue}"/>
                            <TextBox x:Name="MolybdenumValueTextBlock" Grid.Row="10" Grid.Column="1" Text="0.00" TextAlignment="Right" Style="{StaticResource SelectableValue}"/>
                            <TextBox x:Name="ZincValueTextBlock" Grid.Row="11" Grid.Column="1" Text="0.00" TextAlignment="Right" Style="{StaticResource SelectableValue}"/>
                            <TextBox x:Name="ChlorineValueTextBlock" Grid.Row="12" Grid.Column="1" Text="0.00" TextAlignment="Right" Style="{StaticResource SelectableValue}"/>
                            <TextBox x:Name="SilicaValueTextBlock" Grid.Row="13" Grid.Column="1" Text="0.00" TextAlignment="Right" Style="{StaticResource SelectableValue}"/>
                            <TextBox x:Name="HumicAcidValueTextBlock" Grid.Row="14" Grid.Column="1" Text="0.00" TextAlignment="Right" Style="{StaticResource SelectableValue}"/>
                            <TextBox x:Name="FulvicAcidValueTextBlock" Grid.Row="15" Grid.Column="1" Text="0.00" TextAlignment="Right" Style="{StaticResource SelectableValue}"/>
                            <TextBox x:Name="KelpValueTextBlock" Grid.Row="16" Grid.Column="1" Text="0.00" TextAlignment="Right" Style="{StaticResource SelectableValue}"/>
                            <TextBlock Grid.Row="17" Grid.Column="1" Text="" Height="10"/>
                            <TextBox x:Name="TotalPpmValueTextBlock" Grid.Row="18" Grid.Column="1" Text="0.00" TextAlignment="Right" FontWeight="Bold" Style="{StaticResource SelectableValue}"/>
                        </Grid>
                    </Grid>

                    <Grid Grid.Column="1" Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Unit Information" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>

                        <StackPanel Grid.Row="1">
                            <TextBlock x:Name="UnitLabel" Text="PPM (mg/L)" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                All nutrient values are shown in parts per million (PPM). Add fertilizers to your mix by selecting from the available list and entering the quantity per liter or per gallon depending on your selected unit — grams for solids, milliliters for fertilizers marked as liquid (converted by density).
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                When adding new fertilizers, enter the percentage of each nutrient as shown on the label. For phosphorus and potassium, be sure the selected dropdown is accurate for your nutrient label. Most US labels list P and K in their oxide form (P₂O₅ or K₂O).
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                                Conversion formulas:
                                • P₂O₅ to P: multiply by 0.4364
                                • K₂O to K: multiply by 0.8301
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap">
                                Use the Compare button to compare nutrient profiles between different saved mixes. Double-click on a fertilizer name in your current mix to remove it.
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- Footer with status information -->
        <StatusBar Grid.Row="2" Background="#007ACC" Foreground="White" Height="25">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>